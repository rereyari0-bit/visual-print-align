# Template .env untuk aplikasi web di homelab.
# Salin ke file .env di root proyek (sebelah docker-compose.yml), lalu isi nilainya.
#
# Cara cepat generate ANON_KEY & SERVICE_ROLE_KEY:
#   bun docker/generate-jwt-keys.mjs
#
# Hasilnya tersimpan di docker/.env.homelab.keys

# ─── Wajib diisi ─────────────────────────────────────────────────────────────

# ANON_KEY dari output generate-jwt-keys.mjs (baris ANON_KEY=)
SUPABASE_ANON_KEY=

# SERVICE_ROLE_KEY dari output generate-jwt-keys.mjs (baris SERVICE_ROLE_KEY=)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sudah terkonfigurasi di docker-compose.yml ───────────────────────────────
# HOMELAB_IP=10.10.30.32  ← sudah hardcode, tidak perlu ditambahkan di sini
